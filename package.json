{
  "name": "istiak-cli",
  "version": "1.0.0",
  "description": "A modern AI-powered command-line assistant for developers.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "istiak": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/postbuild.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"*.config.{ts,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"*.config.{ts,js}\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "author": "Istiak Rahman",
  "homepage": "https://github.com/istiakrahman15/istiak-cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/istiakrahman15/istiak-cli"
  },
  "bugs": {
    "url": "https://github.com/istiakrahman15/istiak-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "ai",
    "developer-tools",
    "openrouter",
    "terminal"
  ],
  "dependencies": {
    "axios": "^1.7.7",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "clipboardy": "^4.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "enquirer": "^2.4.1",
    "fs-extra": "^11.2.0",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "marked": "^14.1.2",
    "marked-terminal": "^7.2.1",
    "ora": "^8.1.0",
    "react": "^18.3.1",
    "wrap-ansi": "^9.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@eslint/js": "^9.11.1",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.6",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
